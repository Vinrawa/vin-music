# Gradle files
.gradle/
build/
/*/build/
/out/

# Local configuration files (contains local SDK paths etc.)
local.properties

# Log files (JVM crash logs and replay logs)
*.log

# Database files (local databases)
*.db
*.db-journal
*.db-shm
*.db-wal
vin_music*.db

# Android Studio/IntelliJ files
.idea/
*.iml
.cxx/
/captures/
.navigation/

# OS-generated files
.DS_Store
Thumbs.db

# Kotlin-specific
.kotlin/

# Firebase configuration secrets
/app/google-services.json

# Signing keys
*.jks
*.keystore

# Large local logs / debug artifacts (machine-generated, should not be tracked)
logcat.txt
build_log.txt
mood_hist_clean.txt

# Local working notes / regression snapshots (keep local, don't commit)
*_OLD.txt
*_regression.txt
regression_diff.txt
